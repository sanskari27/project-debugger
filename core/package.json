{
    "name": "debugger-core",
    "version": "1.0.2",
    "description": "A TypeScript library for tracking and debugging web applications. Supports both npm package and CDN usage.",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/types/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./cdn": "./dist/core.min.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "npm run build:types && rollup -c",
        "build:types": "tsc",
        "build:watch": "rollup -c -w",
        "dev": "rollup -c -w",
        "clean": "rimraf dist",
        "prebuild": "npm run clean",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.{ts,js,json}\"",
        "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:debug": "jest --detectOpenHandles",
        "test:npm": "./test/npm-tests/run-all-tests.sh",
        "test:publish": "./scripts/test-publish.sh",
        "publish:npm": "./scripts/publish.sh",
        "prepare": "npm run build"
    },
    "keywords": [
        "typescript",
        "library",
        "cdn",
        "minified",
        "debugger",
        "events",
        "tracking"
    ],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@rollup/plugin-commonjs": "^25.0.0",
        "@rollup/plugin-node-resolve": "^15.0.0",
        "@rollup/plugin-terser": "^0.4.0",
        "@rollup/plugin-typescript": "^11.0.0",
        "@types/jest": "^29.0.0",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "eslint": "^8.0.0",
        "eslint-config-prettier": "^9.0.0",
        "eslint-plugin-prettier": "^5.0.0",
        "jest": "^29.0.0",
        "prettier": "^3.0.0",
        "rimraf": "^5.0.0",
        "rollup": "^3.0.0",
        "ts-jest": "^29.0.0",
        "tslib": "^2.6.0",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=16.0.0"
    },
    "dependencies": {
        "rrweb": "^2.0.0-alpha.4"
    }
}